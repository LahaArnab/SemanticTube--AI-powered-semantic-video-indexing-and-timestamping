YOUTUBE_API_KEY= "YOUTUBE-API-KEY"
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SECONDS=8
TOP_K_VIDEOS=5
TOP_K_MATCHES=3
MAX_CHUNKS_PER_VIDEO=300

# Optional: cookies/proxy for yt-dlp downloads (helps with consent/age-restrictions).
TRANSCRIPT_COOKIES_PATH=cookies.txt
TRANSCRIPT_PROXY=
TRANSCRIPT_PROXY_HTTP=
TRANSCRIPT_PROXY_HTTPS=
TRANSCRIPT_PROXIES=

# Local transcription (yt-dlp + faster-whisper). CPU by default; set device to "cuda" for NVIDIA GPUs.
LOCAL_ASR_MODEL=base
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_COMPUTE_TYPE=int8
LOCAL_ASR_CACHE_DIR=.cache/local_asr
LOCAL_ASR_AUDIO_DIR=.cache/audio
